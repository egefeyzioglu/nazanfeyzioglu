# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
# Postgres connection string. Locally: docker run -d --name nazanfeyzioglu-postgres \
#   -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=nazanfeyzioglu -p 5432:5432 \
#   -v nazanfeyzioglu-pgdata:/var/lib/postgresql/data postgres:16
# In production, the Vercel Marketplace Neon integration injects this automatically.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/nazanfeyzioglu"

# UploadThing
UPLOADTHING_TOKEN='xxxxxxxxxxxxxxxxxxxxxxxxxx'
# Clerk (https://dashboard.clerk.com) — required for the /admin panel.
# The public site works without these. Grant admin access by setting
# `{ "role": "admin" }` in a user's Public metadata in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# For local development before Clerk is configured: set to 1 to open /admin
# without auth. Only honoured when NODE_ENV=development AND the Clerk keys
# above are unset.
# ADMIN_DEV_BYPASS=1

# Stripe (https://dashboard.stripe.com/apikeys) — powers print and digital
# edition checkout. The public site works without these: buy buttons fall
# back to contact links.
STRIPE_SECRET_KEY=""
# Signing secret for /api/stripe/webhook (Developers → Webhooks; subscribe to
# checkout.session.completed, checkout.session.async_payment_succeeded and
# charge.refunded). Orders are only recorded when this is set. Locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Optional Dashboard-defined shipping rate (shr_…) applied to print
# checkouts; when unset, print checkouts charge no shipping.
# STRIPE_SHIPPING_RATE_ID=""
# Canonical site origin for Stripe redirect URLs (defaults to the request's
# own origin behind Vercel's proxy headers).
# SITE_URL="https://example.com"
